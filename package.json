{
  "name": "content-lens",
  "version": "1.0.3",
  "private": true,
  "description": "A local-first browser extension for intentional content filtering.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "benchmark": "vitest run --disableConsoleIntercept --config vitest.benchmark.config.ts",
    "benchmark:phase0": "node tests/performance/run-phase0-benchmark.mjs",
    "brand:icons": "node scripts/brand/generate-icons.mjs",
    "brand:icons:check": "node scripts/brand/generate-icons.mjs --check",
    "build:adapter-e2e:chrome": "wxt build -b chrome --config wxt.adapter-e2e.config.ts",
    "build:adapter-e2e:firefox": "wxt build -b firefox --config wxt.adapter-e2e.config.ts",
    "build:chrome": "wxt build -b chrome && pnpm bundle:check:chrome",
    "build:firefox": "wxt build -b firefox && pnpm bundle:check:firefox",
    "bundle:check:chrome": "node scripts/ci/bundle-size-guard.ts .output/chrome-mv3",
    "bundle:check:firefox": "node scripts/ci/bundle-size-guard.ts .output/firefox-mv2",
    "ci:local": "pnpm guard:public && pnpm typecheck && pnpm deps:check && pnpm test:coverage && pnpm test:soak",
    "commitlint": "commitlint",
    "deps:check": "knip --strict --include dependencies,unlisted && knip --include unlisted,unresolved,binaries && knip --cycles",
    "design-system:check": "node scripts/ci/design-system-guard.ts",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "biome check --write --no-errors-on-unmatched .",
    "guard:public": "pnpm docs:check && pnpm design-system:check && pnpm brand:icons:check && pnpm lint && node scripts/ci/public-guard.ts",
    "i18n:check": "node src/i18n/generate-message-keys.ts --check",
    "i18n:generate": "node src/i18n/generate-message-keys.ts",
    "lint": "biome check --no-errors-on-unmatched .",
    "postinstall": "wxt prepare",
    "release:guard": "node scripts/release/guard-artifact.mjs",
    "release:package": "node scripts/release/package.mjs",
    "release:status": "node scripts/release/store-status.mjs",
    "release:submit:chrome": "node scripts/release/submit-chrome.mjs",
    "release:verify": "node scripts/release/verify-provenance.mjs",
    "scan:secrets": "kingfisher scan . --git-history none --no-validate --redact --exclude node_modules --exclude test-results --exclude playwright-report --exclude coverage --exclude .output --exclude .release",
    "smoke:youtube-live": "node scripts/evidence/youtube-live-smoke.mjs",
    "test": "vitest run",
    "test:a11y": "vitest run --project a11y",
    "test:browser": "node scripts/ci/run-browser-tests.mjs",
    "test:browser:packaged": "playwright test tests/browser/panel-open-smoke.spec.ts tests/browser/v01-journey.spec.ts",
    "test:contract": "vitest run --project unit tests/contract",
    "test:coverage": "vitest run --coverage",
    "test:fault": "vitest run --project unit tests/fault",
    "test:i18n": "pnpm i18n:check && vitest run --project i18n",
    "test:migrations": "vitest run --project migrations",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:security": "vitest run --project unit tests/security",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "test:storage": "vitest run --project unit tests/storage",
    "test:sync": "vitest run --project unit tests/sync",
    "test:unit": "vitest run --project unit",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:w": "vitest",
    "typecheck": "pnpm i18n:check && wxt prepare && tsc --noEmit"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "dependencies": {
    "lucide-react": "1.26.0",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.4",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.1",
    "knip": "6.32.0",
    "lefthook": "2.1.10",
    "postcss": "8.5.23",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "web-ext": "10.5.0",
    "wxt": "0.21.1"
  }
}
