{
  "entry": [
    "src/entrypoints/**/*.{ts,tsx}!",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx,mjs}",
    "wxt.adapter-e2e.config.ts"
  ],
  "project": [
